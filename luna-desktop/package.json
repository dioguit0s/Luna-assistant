{
  "name": "luna-desktop",
  "version": "0.1.0",
  "description": "Satélite virtual da Luna — app de bandeja para Windows",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc && node scripts/copy-renderer.mjs",
    "watch": "tsc --watch",
    "dev": "tsc && node scripts/copy-renderer.mjs && electron .",
    "start": "electron .",
    "test": "node --import tsx --test src/main/state.test.ts src/main/menu.test.ts src/main/session.test.ts src/main/mic-dump.test.ts src/main/ws/protocol.test.ts src/shared/pcm.test.ts src/shared/wav.test.ts",
    "test:wakeword": "wakeword-sidecar\\.venv\\Scripts\\python.exe -m unittest discover -s wakeword-sidecar -t wakeword-sidecar -p \"*_test.py\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "electron": "^43.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
