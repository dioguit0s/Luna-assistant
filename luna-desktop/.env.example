WS_AUTH_SECRET=dev-secret-change-me
WS_SERVER_URL=ws://localhost:8080
ROOM_ID=desktop_diogo
# DEVICE_ID não entra aqui: é um UUID gerado na primeira execução e persistido
# em userData (marco 2), não configurado à mão.

# Opcionais — trocam o modelo/threshold do sidecar de wake word (marco 4) sem
# mudar código. Omitidos, o sidecar usa os próprios defaults
# (hey_luna_trained.tflite, threshold 0.97). Ver wakeword-sidecar/README.md
# sobre o recall baixo medido do hey_luna_trained em voz real — okay_nabu.tflite
# é uma alternativa provisória mais confiável, mas muda a frase de ativação.
# WAKEWORD_MODEL=../luna-firmware/models/okay_nabu.tflite
# WAKEWORD_THRESHOLD=0.97
