# Dependencies
node_modules/

# Environment
*.env
!*.env.example
.env
.env.local
.env.*.local

# Build
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/

# PlatformIO / firmware
luna-firmware/.pio/
luna-firmware/include/secrets.h

# ESPHome (atuador) — segredos e cache de build
luna-firmware-actuator/secrets.yaml
luna-firmware-actuator/.esphome/

# Infra / Docker (dados persistentes dos containers)
infra/homeassistant/config/
infra/redis/data/

# Electron (luna-desktop) — saídas de empacotamento.
# Atenção no marco 5: o `build/` acima é ignorado, e é justamente o diretório de
# entrada padrão do electron-builder (buildResources) — apontar para assets/.
luna-desktop/out/
luna-desktop/release/
luna-desktop/dist-electron/

# Sidecar de wake word (luna-desktop/wakeword-sidecar) — venv Python e cache.
luna-desktop/wakeword-sidecar/.venv/
__pycache__/
*.pyc

# Gravações longas de calibração do wake word (TV/conversa de fundo) — só as
# fixtures curtas (okay-nabu.wav, hey-luna.wav) são commitadas.
luna-desktop/wakeword-sidecar/fixtures/*-longa*.wav
luna-desktop/wakeword-sidecar/fixtures/background-*.wav

# Dump de microfone (LUNA_DUMP_MIC) — pode conter áudio da casa do usuário;
# nunca commitar por acidente se gerado dentro do repo.
luna-desktop/mic-dump-*.wav

# Banco de lembretes em desenvolvimento (default de `resolveDbPath` quando não
# há $STATE_DIRECTORY do systemd). Em produção o banco vive em
# /var/lib/luna-server, fora do repo.
luna-server/.luna-state/
