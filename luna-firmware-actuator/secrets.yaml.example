# ============================================================================
# Copie este arquivo para "secrets.yaml" e preencha com os valores reais.
# secrets.yaml está no .gitignore — NÃO comitar credenciais.
#
# O ESPHome procura o secrets.yaml no mesmo diretório do YAML do node.
# ============================================================================

# --- Wi-Fi ---
# Mesma rede L2/VLAN do Home Assistant (192.168.0.0/24). O mDNS usado pelo
# OTA e pela descoberta do HA não atravessa roteador — ver infra/README.md.
wifi_ssid: "sua-rede-wifi"
wifi_password: "sua-senha-wifi"

# Senha do AP de resgate ("luz-bancada-fallback"), usado quando o Wi-Fi falha.
# Mínimo de 8 caracteres.
ap_password: "resgate-luz-bancada"

# --- API nativa do ESPHome ---
# Chave de 32 bytes em base64. O Home Assistant pede esse valor ao adicionar
# o dispositivo. Gerar com:
#   openssl rand -base64 32
# (no Windows sem openssl: PowerShell ->
#   [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})) )
api_encryption_key: "cole-aqui-a-chave-base64-de-32-bytes"

# --- OTA ---
# Senha exigida para gravar firmware pela rede. Sem ela, qualquer um na LAN
# consegue substituir o firmware do node.
ota_password: "senha-ota-change-me"
