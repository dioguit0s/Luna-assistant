[Unit]
Description=Luna Server (orquestrador central)
Documentation=https://github.com/dioguit0s/Luna-assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luna
Group=luna

# Symlink trocado atomicamente pelo activate.sh a cada deploy.
WorkingDirectory=/opt/luna/current
# `--disable-warning`: o `node:sqlite` emite ExperimentalWarning a cada boot, e
# StandardError=journal despejaria isso no journal toda vez.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/index.js

# Segredos ficam fora do repositorio.
EnvironmentFile=/etc/luna-server.env
Environment=NODE_ENV=production
# Sem isto o processo herda o fuso do host (UTC nas VMs), e a hora que a Luna
# fala -- e a que o agendador usa -- sai 3h errada. O codigo tambem nao depende
# do TZ do processo (src/time/clock.ts fixa America/Sao_Paulo); esta linha
# mantem log do systemd, `date` e node concordando na mesma maquina.
Environment=TZ=America/Sao_Paulo

Restart=always
RestartSec=5

# src/index.ts trata SIGTERM com shutdown gracioso.
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=luna-server

# Banco de lembretes. O systemd cria /var/lib/luna-server com dono luna:luna e
# libera escrita mesmo sob ProtectSystem=strict, sem ReadWritePaths a mao. O
# caminho chega ao processo em $STATE_DIRECTORY (ver resolveDbPath em env.ts).
#
# O banco NAO pode ficar em /opt/luna/current: o activate.sh troca o symlink da
# release a cada deploy e poda as antigas -- o alarme das 7h sumiria no deploy
# das 3h.
StateDirectory=luna-server

# Hardening. Fora do StateDirectory acima, o processo nao escreve em disco.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
