[Unit]
Description=Luna Server (orquestrador central)
Documentation=https://github.com/dioguit0s/Luna-assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luna
Group=luna

# Symlink trocado atomicamente pelo activate.sh a cada deploy.
WorkingDirectory=/opt/luna/current
ExecStart=/usr/bin/node dist/index.js

# Segredos ficam fora do repositorio.
EnvironmentFile=/etc/luna-server.env
Environment=NODE_ENV=production
# Sem isto o processo herda o fuso do host (UTC nas VMs), e a hora que a Luna
# fala -- e a que o agendador usa -- sai 3h errada. O codigo tambem nao depende
# do TZ do processo (src/time/clock.ts fixa America/Sao_Paulo); esta linha
# mantem log do systemd, `date` e node concordando na mesma maquina.
Environment=TZ=America/Sao_Paulo

Restart=always
RestartSec=5

# src/index.ts trata SIGTERM com shutdown gracioso.
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=luna-server

# Hardening. O processo nao escreve em disco: nenhum ReadWritePaths necessario.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
