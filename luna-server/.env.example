AUDIO_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
WS_AUTH_SECRET=dev-secret-change-me
WS_PORT=8080
LOG_LEVEL=info
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
OPENAI_REALTIME_MODEL=gpt-realtime

# Detecção de fim de fala (todas opcionais; em branco = default do provider).
# Medições em 19/07/2026 não mostraram ganho ajustando a janela do VAD — o
# gargalo está no modelo, não no endpointing. Mantido como knob de diagnóstico.
GEMINI_VAD_SILENCE_MS=
GEMINI_VAD_END_SENSITIVITY=
# Push-to-talk: desliga o VAD do Gemini e usa activityEnd explícito. Exige
# MANUAL_ACTIVITY=true no cliente/satélite, senão a resposta é interrompida.
GEMINI_MANUAL_ACTIVITY=false
# Loga mensagens cruas do Gemini, incluindo transcrição da fala. Só depuração.
GEMINI_DEBUG_MESSAGES=false
# Silêncio (ms) sem novo fragmento de fala até o servidor mandar speaking_start
# ao satélite (LED apaga, mic desliga) sem esperar o primeiro áudio de resposta.
# Fecha a janela de espera do modelo/TTS (ver nota acima: é aí que mora o
# atraso, não no endpointing) em que o LED ficava aceso com o comando já
# capturado. Default: 500.
USER_SILENCE_CUTOFF_MS=

# Equivalentes OpenAI dos knobs acima (só valem com AUDIO_PROVIDER=openai).
# server_vad corta o turno por silêncio, como o VAD do Gemini — mantenha
# OPENAI_VAD_SILENCE_MS igual ao GEMINI_VAD_SILENCE_MS para o TTFAB dos dois
# providers ser comparável. semantic_vad decide o fim de turno pelo conteúdo da
# fala e ignora a janela de silêncio.
OPENAI_VAD_TYPE=server_vad
OPENAI_VAD_SILENCE_MS=
# Loga mensagens cruas da Realtime, incluindo transcrição da fala. Só depuração.
OPENAI_DEBUG_MESSAGES=false
OPENAI_VOICE=marin

# Épico 3 — Home Assistant
HA_URL=http://192.168.0.10:8123
HA_TOKEN=
# Overrides do registro de dispositivos (apelidos, exclusões, entradas manuais).
# O catálogo em si vem do próprio HA: cadastre o dispositivo lá, atribua uma
# área, e ele fica acionável no próximo refresh — sem editar arquivo nenhum.
DEVICES_CONFIG_PATH=config/devices.json
# Intervalo de revalidação do registro, em ms. Default: 300000 (5 min).
DEVICE_REGISTRY_TTL_MS=300000

# Alarmes e lembretes
# Caminho ABSOLUTO do banco SQLite. Vazio usa, nesta ordem, o $STATE_DIRECTORY do
# systemd (/var/lib/luna-server em producao) ou ./.luna-state/luna.db em dev.
# Nunca aponte para dentro de /opt/luna/current: o deploy troca esse symlink e
# poda releases antigas.
LUNA_DB_PATH=
# Carencia do catch-up: um lembrete mais atrasado que isto no boot nao toca, vira
# `missed`. Um deploy as 3h depois de 3h fora nao pode disparar o alarme das 6:30
# as 9:30. Default: 900000 (15 min).
MISSED_GRACE_MS=900000
# Teto do ciclo de toque inteiro. Default: 300000 (5 min).
ALARM_MAX_RING_MS=300000
# Teto de comodos tocando ao mesmo tempo. Default: 20.
REMINDER_MAX_CONCURRENT=20
# Teto de lembretes vivos por sala — contem um loop de tool calls. Default: 20.
REMINDER_MAX_PER_ROOM=20
# Comodo onde o alarme toca quando o satelite de origem esta offline. Vazio
# DESLIGA o fallback: melhor silencio que adivinhar errado onde tem gente.
REMINDER_FALLBACK_ROOM_ID=
# Janela entre rajadas em que a wake word volta a ficar ligada — a unica em que
# "Luna, para o alarme" e ouvido. NAO MEDIDO NO HARDWARE (2026-08-24): derivado
# das constantes do firmware. Default: 6000.
RING_LISTEN_WINDOW_MS=6000
# Silencio minimo desde a ultima fala do usuario para uma rajada poder sair, para
# o alarme nao cortar a frase de quem esta falando. Default: 2000.
RING_BARGEIN_GUARD_MS=2000
# Espera antes de tentar de novo quando a sala emudeceu no meio do toque.
# Default: 60000.
RING_SILENT_RETRY_MS=60000
# Teto de adiamento pelo guard de barge-in. Passado ele a rajada sai por cima da
# fala do usuario: um comodo que nunca silencia (o --mic do cliente de teste, o
# desktop) nao pode significar um alarme que nunca toca. NAO MEDIDO NO HARDWARE
# (2026-08-24). Default: 3000.
RING_MAX_DEFER_MS=3000
# Teto da soneca pedida por voz, em minutos. Default: 60.
REMINDER_SNOOZE_MAX_MINUTES=60
