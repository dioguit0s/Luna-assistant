{
  "name": "luna-satelite-base",
  "version": "1.0.0",
  "description": "Luna — placa-base do satélite ESP32-S3 (tscircuit)",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit",
    "check": "tsci check netlist && tsci check pin_specification && tsci check placement && tsci check shorts && tsci check pcb-style",
    "export:kicad": "tsci export index.circuit.tsx -f kicad_zip -o ../build/satelite-base-fab/satelite-base-kicad.zip",
    "export:gerbers": "tsci export index.circuit.tsx -f gerbers -o ../build/satelite-base-fab/satelite-base-gerbers.zip"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tscircuit": "^0.0.3161",
    "typescript": "^5.0.0"
  },
  "private": true
}
