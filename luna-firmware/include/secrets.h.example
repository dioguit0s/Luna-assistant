#pragma once

// ============================================================================
// Copie este arquivo para "secrets.h" e preencha com os valores reais.
// secrets.h está no .gitignore — NÃO comitar credenciais.
// ============================================================================

// --- Wi-Fi ---
#define WIFI_SSID "sua-rede-wifi"
#define WIFI_PASS "sua-senha-wifi"

// --- Servidor Luna (luna-server) ---
#define LUNA_HOST "192.168.0.10" // IP do PC/servidor na rede local
#define LUNA_PORT 8080           // WS_PORT do luna-server (padrão 8080)
#define LUNA_WS_PATH "/"         // path do WebSocket

// --- Contexto do satélite ---
// DEVE ser idêntico ao area_id da área correspondente no Home Assistant —
// string exata, com underscores. Áreas da casa: sala_de_estar, cozinha, quarto.
// Conferir com: curl -H "Authorization: Bearer $HA_TOKEN" \
//   http://192.168.0.10:8123/api/template -X POST -d '{"template": "{{ areas() }}"}'
#define ROOM_ID "sala_de_estar" // room_id lógico deste cômodo

// --- Autenticação ---
// DEVE ser idêntico ao WS_AUTH_SECRET no .env do luna-server.
// O token é HMAC-SHA256(WS_AUTH_SECRET, device_id), com device_id = MAC do ESP32.
//
// Este valor é usado APENAS no provisionamento do primeiro boot: o firmware o
// grava na NVS e, dos boots seguintes em diante, lê o segredo de lá. Para trocar
// o segredo depois, apague a NVS (pio run -t erase) ou use
// SecretStore::setAuthSecret().
#define WS_AUTH_SECRET "dev-secret-change-me"
