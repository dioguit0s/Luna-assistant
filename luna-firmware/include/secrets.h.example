#pragma once

// ============================================================================
// Copie este arquivo para "secrets.h" e preencha com os valores reais.
// secrets.h está no .gitignore — NÃO comitar credenciais.
//
// PROVISIONAMENTO: estes valores só são usados para semear a NVS do ESP32.
// No boot, cada um é gravado na NVS apenas se a chave ainda estiver vazia lá
// e o valor aqui não for vazio. Dali em diante é a NVS que manda — regravar o
// firmware com outro secrets.h NÃO muda a configuração de um satélite já
// provisionado (ver luna-firmware/README.md, "Configuração e provisionamento").
//
// Binário genérico (para publicar/OTA): deixe todos os campos vazios ("" e
// LUNA_PORT 0) ou compile sem este arquivo. Ele funciona em qualquer satélite
// já provisionado e não carrega credencial nenhuma.
// ============================================================================

// --- Wi-Fi ---
#define WIFI_SSID "sua-rede-wifi"
#define WIFI_PASS "sua-senha-wifi"

// --- Servidor Luna (luna-server) ---
#define LUNA_HOST "192.168.0.10" // IP do PC/servidor na rede local
#define LUNA_PORT 8080           // WS_PORT do luna-server (padrão 8080); 0 = vazio
#define LUNA_WS_PATH "/"         // path do WebSocket (compilado, não vai para a NVS)

// --- Contexto do satélite ---
// Sala inicial. DEVE ser idêntica ao area_id da área correspondente no Home
// Assistant — string exata, minúsculas/dígitos/underscore. Áreas da casa:
// sala_de_estar, cozinha, quarto. Conferir com:
//   curl -H "Authorization: Bearer $HA_TOKEN" \
//   http://192.168.0.10:8123/api/template -X POST -d '{"template": "{{ areas() }}"}'
// Depois do primeiro boot, troque a sala pelo painel (Satélites -> SALA): o
// satélite grava na NVS e reconecta sozinho, sem USB.
#define ROOM_ID "sala_de_estar"

// --- Autenticação ---
// DEVE ser idêntico ao WS_AUTH_SECRET no .env do luna-server.
// O token é HMAC-SHA256(WS_AUTH_SECRET, device_id), com device_id = MAC do ESP32.
#define WS_AUTH_SECRET "dev-secret-change-me"

// --- Reprovisionamento ---
// 1 = os valores NÃO vazios acima sobrescrevem o que está na NVS a cada boot
// (trocar Wi-Fi, servidor ou segredo de um satélite já instalado). Grave, deixe
// bootar uma vez e VOLTE PARA 0 — senão a sala escolhida pelo painel volta a
// ser o ROOM_ID daqui a cada reboot. Alternativa: pio run -t erase.
#define LUNA_FORCE_PROVISION 0
